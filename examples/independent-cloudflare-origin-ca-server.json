{
  "certificate_providers": [
    {
      "type": "cloudflare-origin-ca",
      "tag": "origin",
      "domain": ["example.com", "*.example.com"],
      "api_token": "REPLACE_WITH_CLOUDFLARE_API_TOKEN",
      "request_type": "origin-ecc",
      "requested_validity": 90
    }
  ],
  "inbounds": [
    {
      "type": "trojan",
      "tag": "server",
      "listen": "127.0.0.1",
      "listen_port": 8443,
      "users": [{"password": "REPLACE_WITH_PROXY_PASSWORD"}],
      "tls": {"enabled": true, "certificate_provider": "origin"}
    }
  ],
  "outbounds": [{"type": "direct", "tag": "direct"}]
}
