{
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "endpoints": [
    {
      "type": "masque-server",
      "tag": "server",
      "listen": "127.0.0.1",
      "listen_port": 8448,
      "users": [
        {
          "username": "client",
          "password": "replace-with-long-random-password"
        }
      ],
      "address": [
        "10.44.0.1/24",
        "fd44::1/64"
      ],
      "tls": {
        "enabled": true,
        "certificate_path": "server.crt",
        "key_path": "server.key"
      },
      "version": [
        1,
        2,
        3
      ],
      "path": "/vpn/{target}/{ipproto}/",
      "system": true,
      "name": "masque0"
    }
  ]
}
