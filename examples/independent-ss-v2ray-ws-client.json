{
  "inbounds": [
    {
      "type": "mixed",
      "tag": "local",
      "listen": "127.0.0.1",
      "listen_port": 1080
    }
  ],
  "outbounds": [
    {
      "type": "shadowsocks",
      "tag": "proxy",
      "method": "aes-256-gcm",
      "password": "replace-with-a-strong-password",
      "plugin": "v2ray-plugin",
      "plugin_opts": "mode=websocket;host=localhost;path=/lanboat;mux=8",
      "server": "127.0.0.1",
      "server_port": 8388
    }
  ]
}
