{
  "log": {
    "level": "info"
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "local",
      "listen": "127.0.0.1",
      "listen_port": 1080
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    },
    {
      "type": "block",
      "tag": "block"
    }
  ],
  "route": {
    "rules": [
      {
        "user_id": [
          1000
        ],
        "outbound": "direct"
      }
    ],
    "final": "block"
  },
  "dns": {
    "servers": [
      {
        "type": "local",
        "tag": "local"
      }
    ],
    "rules": [
      {
        "user_id": [
          1000
        ],
        "action": "route",
        "server": "local"
      },
      {
        "action": "reject"
      }
    ]
  }
}
