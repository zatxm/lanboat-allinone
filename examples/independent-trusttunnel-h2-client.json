{
  "log": {
    "level": "info"
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "local",
      "listen": "127.0.0.1",
      "listen_port": 1080
    }
  ],
  "outbounds": [
    {
      "type": "trusttunnel",
      "tag": "proxy",
      "http_version": 2,
      "server": "127.0.0.1",
      "server_port": 48443,
      "username": "example-user",
      "password": "replace-this-example-password",
      "tls": {
        "enabled": true,
        "server_name": "localhost",
        "certificate_path": "server-ca.crt"
      }
    }
  ],
  "route": {
    "final": "proxy"
  }
}
