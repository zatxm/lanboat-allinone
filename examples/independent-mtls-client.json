{
  "log": {
    "level": "info"
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "local",
      "listen": "127.0.0.1",
      "listen_port": 1080
    }
  ],
  "outbounds": [
    {
      "type": "trojan",
      "tag": "proxy",
      "server": "127.0.0.1",
      "server_port": 8443,
      "password": "replace-with-a-long-random-password",
      "tls": {
        "enabled": true,
        "engine": "go",
        "server_name": "localhost",
        "min_version": "1.2",
        "curve_preferences": [
          "X25519",
          "P256"
        ],
        "certificate_path": "server-ca.crt",
        "client_certificate_path": "client.crt",
        "client_key_path": "client.key"
      }
    }
  ],
  "route": {
    "final": "proxy"
  }
}
