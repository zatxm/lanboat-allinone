{
  "log": {
    "level": "info"
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "local",
      "listen": "127.0.0.1",
      "listen_port": 1080
    }
  ],
  "outbounds": [
    {
      "type": "ssh",
      "tag": "proxy",
      "server": "127.0.0.1",
      "server_port": 2222,
      "username": "client",
      "password": "change-this-password",
      "host_key": [
        "SHA256:REPLACE_WITH_SERVER_HOST_KEY_FINGERPRINT"
      ]
    }
  ],
  "route": {
    "final": "proxy"
  }
}
