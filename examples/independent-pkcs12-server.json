{
  "log": {
    "level": "info"
  },
  "inbounds": [
    {
      "type": "trojan",
      "tag": "server",
      "listen": "127.0.0.1",
      "listen_port": 8443,
      "users": [
        {
          "password": "replace-with-a-long-random-password"
        }
      ],
      "tls": {
        "enabled": true,
        "min_version": "1.2",
        "client_authentication": "require-and-verify",
        "client_certificate_path": [
          "client-ca.crt"
        ],
        "pkcs12_path": "server.p12",
        "pkcs12_password": "replace-with-certificate-password"
      }
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    }
  ]
}
