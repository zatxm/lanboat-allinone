{
  "inbounds": [
    {
      "type": "mixed",
      "tag": "local",
      "listen": "127.0.0.1",
      "listen_port": 1080
    }
  ],
  "outbounds": [
    {
      "type": "hysteria2",
      "tag": "proxy",
      "server": "127.0.0.1",
      "server_port": 18445,
      "password": "change-this-password",
      "tls": {
        "enabled": true,
        "server_name": "localhost",
        "certificate_path": "server-ca.crt"
      },
      "congestion_control": "bbr2"
    }
  ],
  "route": {
    "final": "proxy"
  }
}
