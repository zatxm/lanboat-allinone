{
  "log": {"level": "info"},
  "endpoints": [
    {
      "type": "tailscale",
      "tag": "tailnet",
      "auth_key": "replace-with-your-auth-key",
      "state_directory": "tailscale-router-state",
      "hostname": "lanboat-router",
      "advertise_routes": ["192.168.50.0/24"],
      "advertise_exit_node": true,
      "advertise_tags": ["tag:router"],
      "force_derp": false,
      "udp_timeout": "5m"
    }
  ],
  "outbounds": [{"type": "direct", "tag": "direct"}],
  "route": {"final": "direct"}
}
