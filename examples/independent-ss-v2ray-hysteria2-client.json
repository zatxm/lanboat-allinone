{
  "inbounds": [
    {
      "type": "mixed",
      "tag": "local",
      "listen": "127.0.0.1",
      "listen_port": 1080
    }
  ],
  "outbounds": [
    {
      "type": "shadowsocks",
      "tag": "proxy",
      "server": "127.0.0.1",
      "server_port": 8443,
      "method": "aes-128-gcm",
      "password": "replace-with-your-password",
      "plugin": "v2ray-plugin",
      "plugin_opts": "mode=hysteria2;password=replace-with-transport-password;tls;host=localhost;cert=server-ca.crt"
    }
  ],
  "route": {
    "final": "proxy"
  }
}
