{
  "endpoints": [
    {
      "type": "masque-client",
      "tag": "proxy",
      "server": "127.0.0.1",
      "server_port": 8448,
      "username": "client",
      "password": "replace-with-long-random-password",
      "tls": {
        "enabled": true,
        "server_name": "localhost",
        "certificate_path": "server-ca.crt"
      },
      "version": 3,
      "path": "/vpn/{target}/{ipproto}/",
      "disable_version_fallback": false,
      "advertise_routes": [
        "192.0.2.0/24",
        "2001:db8:44::/64"
      ]
    }
  ],
  "route": {
    "final": "proxy",
    "rules": [
      {
        "inbound": [
          "proxy"
        ],
        "outbound": "direct"
      }
    ]
  },
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    }
  ]
}
