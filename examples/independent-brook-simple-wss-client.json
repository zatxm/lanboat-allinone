{
  "inbounds": [
    {
      "type": "mixed",
      "tag": "local",
      "listen": "127.0.0.1",
      "listen_port": 1080
    }
  ],
  "outbounds": [
    {
      "type": "brook",
      "tag": "proxy",
      "server": "127.0.0.1",
      "server_port": 9999,
      "password": "replace-this-demo-password",
      "transport": {
        "type": "ws",
        "path": "/brook"
      },
      "tls": {
        "enabled": true,
        "server_name": "localhost",
        "certificate_path": "server-ca.crt"
      },
      "without_brook_protocol": true
    }
  ],
  "route": {
    "final": "proxy"
  }
}
