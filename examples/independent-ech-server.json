{
  "log": {
    "level": "info"
  },
  "inbounds": [
    {
      "type": "trojan",
      "tag": "server",
      "listen": "127.0.0.1",
      "listen_port": 8443,
      "users": [
        {
          "password": "replace-with-a-long-random-password"
        }
      ],
      "tls": {
        "enabled": true,
        "min_version": "1.3",
        "certificate_path": "server.crt",
        "key_path": "server.key",
        "client_authentication": "require-and-verify",
        "client_certificate_path": [
          "client-ca.crt"
        ],
        "ech": {
          "enabled": true,
          "key_path": "ech-keys.pem"
        }
      }
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    }
  ]
}
