{
  "inbounds": [
    {
      "type": "shadowsocks",
      "tag": "server",
      "method": "aes-256-gcm",
      "password": "replace-with-a-strong-password",
      "plugin": "gost",
      "plugin_opts": "mode=mwss;host=localhost;path=/ws",
      "listen": "127.0.0.1",
      "listen_port": 8388,
      "tls": {
        "enabled": true,
        "certificate_path": "server.crt",
        "key_path": "server.key"
      }
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    }
  ]
}
