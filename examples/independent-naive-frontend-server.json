{
  "log": {
    "level": "info"
  },
  "inbounds": [
    {
      "type": "naive",
      "tag": "naive-in",
      "listen": "127.0.0.1",
      "listen_port": 2443,
      "users": [
        {
          "username": "client",
          "password": "replace-with-a-strong-password"
        }
      ],
      "tls": {
        "enabled": true,
        "certificate_path": "server.crt",
        "key_path": "server.key"
      },
      "naive_frontend": "http://127.0.0.1:8080"
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    }
  ]
}
