{
  "inbounds": [
    {
      "type": "masque",
      "tag": "server",
      "listen": "127.0.0.1",
      "listen_port": 8448,
      "users": [
        {
          "username": "client",
          "password": "replace-with-long-random-password"
        }
      ],
      "address": [
        "10.44.0.2/32",
        "fd44::2/128"
      ],
      "tls": {
        "enabled": true,
        "certificate_path": "server.crt",
        "key_path": "server.key"
      },
      "masque_contexts": true
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    }
  ]
}
