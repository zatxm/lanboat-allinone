{
  "log": {"level": "info"},
  "inbounds": [
    {"type": "mixed", "tag": "local", "listen": "127.0.0.1", "listen_port": 2080}
  ],
  "endpoints": [
    {
      "type": "tailscale",
      "tag": "tailnet",
      "state_directory": "tailscale-interactive-state",
      "hostname": "lanboat",
      "on_demand": true,
      "taildrop_directory": "received-files",
      "udp_timeout": "5m"
    }
  ],
  "route": {"final": "tailnet"}
}
