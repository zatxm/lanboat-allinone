{
  "log": {"level": "info"},
  "inbounds": [{
    "type": "openconnect",
    "tag": "vpn",
    "listen": "::",
    "listen_port": 48443,
    "users": [{"username": "example-user", "password": "replace-this-example-password"}],
    "tls": {"enabled": true, "max_version": "1.2", "certificate_path": "server.crt", "key_path": "server.key"},
    "rekey_time": "30m",
    "rekey_method": "ssl"
  }],
  "outbounds": [{"type": "direct", "tag": "direct"}],
  "route": {"final": "direct"}
}
