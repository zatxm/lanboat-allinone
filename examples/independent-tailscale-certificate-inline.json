{
  "endpoints": [
    {
      "type": "tailscale",
      "tag": "tailnet",
      "hostname": "lanboat-server",
      "state_directory": "tailscale-state",
      "on_demand": true
    }
  ],
  "inbounds": [
    {
      "type": "hysteria2",
      "tag": "server",
      "listen": "127.0.0.1",
      "listen_port": 8443,
      "users": [{"password": "replace-with-a-private-password"}],
      "tls": {
        "enabled": true,
        "certificate_provider": {"type": "tailscale", "endpoint": "tailnet"}
      }
    }
  ],
  "outbounds": [{"type": "direct", "tag": "direct"}],
  "route": {"final": "direct"}
}
